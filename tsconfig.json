{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "composite": true,
    "strict": true,
    "jsx": "preserve",
    "downlevelIteration": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    // "composite" implies "incremental", whose build-info file defaults to
    // <outDir>/tsconfig.tsbuildinfo -- i.e. straight into dist/, which is the
    // directory published to gh-pages. Redirect it into the cache so a compiler
    // scratch file does not end up served as part of the site.
    "tsBuildInfoFile": "node_modules/.cache/sol-tsconfig.tsbuildinfo",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "es2019"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
