{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "composite": true,
    "strict": true,
    "jsx": "preserve",
    "downlevelIteration": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "es2019"
    ]
  },
  "include": [
    "plugins/*.ts",
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
